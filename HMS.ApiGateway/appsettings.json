{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "hotel-route": {
        "ClusterId": "hotel-cluster",
        "Match": {
          "Path": "/api/{r:regex(^(hotels|amenities|hotelamenities)$)}/{**catch-all}"
        }
      },
      "tenant-route": {
        "ClusterId": "tenant-cluster",
        "Match": {
          "Path": "/api/{r:regex(^(tenants|subscriptionplans|subscriptions)$)}/{**catch-all}"
        }
      },
      "room-route": {
        "ClusterId": "room-cluster",
        "Match": {
          "Path": "/api/{r:regex(^(roomtypes|rooms|rateplans|roomtypeamenities)$)}/{**catch-all}"
        }
      },
      "staff-route": {
        "ClusterId": "staff-cluster",
        "Match": {
          "Path": "/api/{r:regex(^(staffs|departments|designations|staffnotes|staffdocuments)$)}/{**catch-all}"
        }
      },
      "attendance-route": {
        "ClusterId": "attendance-cluster",
        "Match": {
          "Path": "/api/{r:regex(^(attendances|attendanceanomalies|leaveapplications|shifts)$)}/{**catch-all}"
        }
      },
      "billing-route": {
        "ClusterId": "billing-cluster",
        "Match": {
          "Path": "/api/{r:regex(^(invoices|payments)$)}/{**catch-all}"
        }
      },
      "guest-route": {
        "ClusterId": "guest-cluster",
        "Match": {
          "Path": "/api/{r:regex(^(guests|bookings|reservations)$)}/{**catch-all}"
        }
      },
      "operational-route": {
        "ClusterId": "operational-cluster",
        "Match": {
          "Path": "/api/{r:regex(^(maintenance|housekeeping|lostandfound|roominspections|servicerequests|stafftaskassignments)$)}/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "d1": {
            "Address": "https://localhost:7170"
          }
        }
      },
      "hotel-cluster": {
        "Destinations": {
          "d1": {
            "Address": "https://localhost:7136"
          }
        }
      },
      "tenant-cluster": {
        "Destinations": {
          "d1": {
            "Address": "https://localhost:7225"
          }
        }
      },
      "room-cluster": {
        "Destinations": {
          "d1": {
            "Address": "https://localhost:7256"
          }
        }
      },
      "staff-cluster": {
        "Destinations": {
          "d1": {
            "Address": "https://localhost:7104"
          }
        }
      },
      "attendance-cluster": {
        "Destinations": {
          "d1": {
            "Address": "https://localhost:7005"
          }
        }
      },
      "billing-cluster": {
        "Destinations": {
          "d1": {
            "Address": "https://localhost:7253"
          }
        }
      },
      "guest-cluster": {
        "Destinations": {
          "d1": {
            "Address": "https://localhost:7252"
          }
        }
      },
      "operational-cluster": {
        "Destinations": {
          "d1": {
            "Address": "https://localhost:7205"
          }
        }
      }
    }
  },
  "Cors": {
    "Origins": [
      "http://localhost:5173"
    ]
  }
}