{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Transforms": [
    { "RequestHeaderCopy": "Authorization" }
  ],
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "hotel-route": {
        "ClusterId": "hotel-cluster",
        "Match": { "Path": "/api/{hotelresource:regex(^(hotels|amenities|hotelamenities)$)}/{**catch-all}" }
      },
      "tenant-route": {
        "ClusterId": "tenant-cluster",
        "Match": { "Path": "/api/{tenantresource:regex(^(tenants|subscriptionplans|subscriptions)$)}/{**catch-all}" }
      },
      "room-route": {
        "ClusterId": "room-cluster",
        "Match": { "Path": "/api/{roomresource:regex(^(roomtypes|rooms|rateplans|roomtypeamenities)$)}/{**catch-all}" }
      },
      "staff-route": {
        "ClusterId": "staff-cluster",
        "Match": { "Path": "/api/{staffresource:regex(^(staffs|departments|staffnotes|staffdocuments)$)}/{**catch-all}" }
      },
      "attendance-route": {
        "ClusterId": "attendance-cluster",
        "Match": {
          "Path": "/api/{attendanceresource:regex(^(attendances|attendanceanomalies|leaveapplications|shifts|shiftallocations|shiftswaps)$)}/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": { "d1": { "Address": "https://localhost:7170" } }
      },
      "hotel-cluster": {
        "Destinations": { "d1": { "Address": "https://localhost:7136" } }
      },
      "tenant-cluster": {
        "Destinations": { "d1": { "Address": "https://localhost:7225" } }
      },
      "room-cluster": {
        "Destinations": { "d1": { "Address": "https://localhost:7256" } }
      },
      "staff-cluster": {
        "Destinations": { "d1": { "Address": "https://localhost:7104" } }
      },
      "attendance-cluster": {
        "Destinations": { "d1": { "Address": "https://localhost:7005" } }
      }
    }
  }
}