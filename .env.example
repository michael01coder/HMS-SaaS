# Copy to .env inside every service's Api/WebApi project folder:
#   AuthService/HMS.AuthService.Api            TenantService/HMSTenantService.Api
#   HotelService/HMSHotelServices.Api          RoomManagementService/RoomManagementService.Api
#   StaffService/HMS.StaffService.WebApi      AttendanceService/HMS.AttendanceService.Api
#   GuestService/HMS.GuestService.WebApi      BillingService/HMS.BillingService.Api
#   OperationService/HMS.OperationalService.Api
#
# JWT_SECRET_KEY and INTERNAL_API_KEY must be identical in every file.
JWT_SECRET_KEY=replace-with-one-shared-secret-of-32-characters-or-more
INTERNAL_API_KEY=replace-with-a-shared-internal-key
DB_CONNECTION_STRING=Host=localhost;Port=5432;Database=HMSDb;Username=postgres;Password=replace-with-your-postgres-password

# AuthService only: first platform administrator, created on startup if missing.
SEED_SUPERADMIN_EMAIL=admin@example.com
SEED_SUPERADMIN_PASSWORD=ChangeMe123
