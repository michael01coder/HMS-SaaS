# Copy this file to .env inside EACH service's *.Api / *.WebApi project folder
# (AuthService/HMS.AuthService.Api, TenantService/HMSTenantService.Api,
#  HotelService/HMSHotelServices.Api, RoomManagementService/RoomManagementService.Api,
#  StaffService/HMS.StaffService.WebApi) and fill in real values.
#
# JWT_SECRET_KEY MUST be identical across all five .env files — it's how every
# service validates tokens issued by AuthService without calling it directly.
JWT_SECRET_KEY=replace-with-one-shared-base64-secret

# All five services point at the SAME physical database, by design (see README).
# Each service's own EF Core migrations only touch its own tables.
DB_CONNECTION_STRING=Host=localhost;Port=5432;Database=HMSDataBase;Username=postgres;Password=replace-with-your-postgres-password
